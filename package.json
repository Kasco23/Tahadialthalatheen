{
  "name": "thirty_site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.6"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node -e \"console.log('\\n✅ Using Node.js', process.version, '| pnpm', require('child_process').execSync('pnpm --version').toString().trim())\"",
    "start": "pnpm dev",
    "start:full": "pnpm dev:netlify",
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "build:prod": "pnpm build && node scripts/size-check.mjs",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "check": "pnpm lint && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:install": "playwright install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules .netlify",
    "reinstall": "pnpm clean:all && pnpm install",
    "dep:graph": "madge --json --extensions ts,tsx,js,jsx > full-dependency-map.json src && (madge --image full-graph.dot --extensions ts,tsx,js,jsx src || echo 'Graphviz not available, skipping image generation')",
    "flow:update": "node scripts/flow-from-json.mjs",
    "flow:generate": "node scripts/generate-user-flows.mjs",
    "analyze": "pnpm run build && pnpm exec vite-bundle-analyzer",
    "docs:index": "node scripts/update-docs-index.mjs",
    "docs:index:write": "node scripts/update-docs-index.mjs --write"
  },
  "dependencies": {
    "@appletosolutions/reactbits": "^1.0.3",
    "@daily-co/daily-js": "^0.87.0",
    "@daily-co/daily-react": "^0.24.0",
    "@designbycode/tailwindcss-stripes": "^1.0.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mendable/firecrawl-js": "^4.15.3",
    "@mui/material": "^7.3.9",
    "@netlify/blobs": "^10.7.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@vitejs/plugin-react": "^5.1.4",
    "axios": "^1.13.6",
    "daisyui": "^5.5.19",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.2",
    "dotenv": "^17.3.1",
    "firecrawl-fastmcp": "^1.0.4",
    "firecrawl-mcp": "^3.10.3",
    "flag-icons": "^7.5.0",
    "formik": "^2.4.9",
    "framer-motion": "^12.35.0",
    "gsap": "^3.14.2",
    "immer": "^11.1.4",
    "jotai": "^2.18.0",
    "lucide-react": "^0.577.0",
    "netlify": "^24.0.1",
    "node-vibrant": "^4.0.4",
    "pipx": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.6",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-pro-sidebar": "^1.1.0",
    "react-router-dom": "^7.13.1",
    "react-window": "^2.2.7",
    "socket.io": "^4.8.3",
    "styled-components": "^6.3.11",
    "svgson": "^5.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-gradients": "^3.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/edge-functions": "^3.0.3",
    "@netlify/functions": "^5.1.2",
    "@netlify/vite-plugin": "^2.10.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/browser": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^30.2.0",
    "canvas": "^3.2.1",
    "context7-mcp-server": "^1.0.1",
    "cssnano": "^7.1.3",
    "eslint": "^10.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.2.16",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.2",
    "madge": "^8.0.0",
    "msw": "^2.12.10",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "supabase": "^2.77.0",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.56.1",
    "vite-bundle-analyzer": "^1.3.6",
    "vite-plugin-bundlesize": "^0.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-node": "^7.0.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "7"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "inotify",
      "msw",
      "netlify",
      "netlify-cli",
      "protobufjs",
      "puppeteer",
      "sharp",
      "supabase",
      "unix-dgram"
    ],
    "ignoredBuiltDependencies": [
      "canvas"
    ]
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
